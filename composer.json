{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "doctrine/doctrine-bundle": "^2.14",
        "doctrine/doctrine-migrations-bundle": "^3.4.2",
        "doctrine/orm": "^3.3.3",
        "phpdocumentor/reflection-docblock": "^5.6.2",
        "phpstan/phpdoc-parser": "^2.1",
        "stof/doctrine-extensions-bundle": "^1.14",
        "symfony/asset": "^7.2",
        "symfony/asset-mapper": "^7.2.5",
        "symfony/console": "^7.2.6",
        "symfony/css-selector": "^7.2",
        "symfony/dom-crawler": "^7.2",
        "symfony/dotenv": "^7.2",
        "symfony/flex": "^2.5",
        "symfony/framework-bundle": "^7.2.5",
        "symfony/monolog-bundle": "^3.10",
        "symfony/runtime": "^7.2.3",
        "symfony/stimulus-bundle": "^2.24",
        "symfony/string": "^7.2.6",
        "symfony/twig-bundle": "^7.2",
        "symfony/validator": "^7.2",
        "symfony/yaml": "^7.2.6",
        "symfonycasts/sass-bundle": "^0.8.2",
        "thomaspark/bootswatch": "^5.3",
        "twbs/bootstrap": "^5.3",
        "twig/extra-bundle": "^3.21"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.1",
        "rector/rector": "^2.0",
        "symfony/debug-bundle": "^7.2",
        "symfony/maker-bundle": "^1.63",
        "symfony/phpunit-bridge": "^7.2.6",
        "symfony/stopwatch": "^7.2.4",
        "symfony/web-profiler-bundle": "^7.2.4"
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "^7.2"
        }
    }
}
